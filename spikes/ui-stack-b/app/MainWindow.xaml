<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeBarSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClaudeBar spike (UI stack B)">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="ClaudeBar for Windows · UI stack B" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

            <TextBlock Text="Quota, from ClaudeBar's Quotas module in the Swift DLL" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <Slider x:Name="PercentSlider" Header="Session quota left (%)" Minimum="0" Maximum="100" Value="35" ValueChanged="OnPercentChanged" />
            <TextBlock x:Name="QuotaText" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="RateLimitText" TextWrapping="Wrap" />

            <TextBlock Text="Async Swift call: scan omp session logs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanButton" Content="Scan" Click="OnScan" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="SlowScanButton" Content="Slow scan" Click="OnSlowScan" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <TextBlock x:Name="ScanText" TextWrapping="Wrap" />

            <TextBlock Text="Self-test" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="DiagText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Window>
