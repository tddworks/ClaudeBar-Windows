<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClaudeBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The HUD's text and bars (HudView.cs). Theme brushes through styles, so each
                 follows its element's theme. Every text is secondary or stronger: tertiary
                 measures 3.3:1 on light Mica (design-concept/hud/research.md). -->
            <Style x:Key="HudBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HudStrong" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HudStrongSecondary" TargetType="TextBlock" BasedOn="{StaticResource HudStrong}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="HudStrongCaution" TargetType="TextBlock" BasedOn="{StaticResource HudStrong}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HudStrongCritical" TargetType="TextBlock" BasedOn="{StaticResource HudStrong}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="HudSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HudCaution" TargetType="TextBlock" BasedOn="{StaticResource HudSecondary}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HudCritical" TargetType="TextBlock" BasedOn="{StaticResource HudSecondary}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <!-- Only for the check's calibration (scripts/check-hud.ps1): never on the HUD otherwise. -->
            <Style x:Key="HudCalibrationTertiary" TargetType="TextBlock" BasedOn="{StaticResource HudSecondary}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="HudTrack" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
            <Style x:Key="HudFillAccent" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="HudFillCaution" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HudFillCritical" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="HudTick" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Width" Value="2" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="1" />
            </Style>
            <Style x:Key="HudSkeleton" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>
            <Style x:Key="HudDivider" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <Style x:Key="HudStripDivider" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Margin" Value="0,2,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
