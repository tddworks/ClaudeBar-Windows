<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeBar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClaudeBar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Tertiary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,18,0,8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar, drawn by the app -->
        <StackPanel x:Name="TitleBarArea" Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" VerticalAlignment="Stretch">
            <Image Source="ms-appx:///Assets/ClaudeBar-48.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="ClaudeBar" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- The key came from another PC (ClaudeBar's design §2a): open until answered. -->
            <InfoBar x:Name="CopiedKeyBar" Margin="20,4,20,8" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="This PC has a copy of another PC's leaderboard key"
                     Message="A cloned disk or a restore brought it here. Two PCs on one key overwrite each other's days, so this PC isn't uploading. If the other PC is gone, or this is it after a repair, keep the key here.">
                <InfoBar.ActionButton>
                    <Button x:Name="KeepKeyButton" Content="Keep the key here" Click="OnKeepKeyHere" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Starting at sign-in is offered once, after the first reading, and off until accepted (design). -->
            <InfoBar x:Name="StartupBar" Margin="20,4,20,8" IsOpen="False" IsClosable="True" Severity="Informational"
                     Title="Start ClaudeBar when you sign in?"
                     Message="The HUD and your limits are there from the start. You can turn it off in Settings."
                     Closed="OnStartupBarClosed">
                <InfoBar.ActionButton>
                    <Button Content="Start with Windows" Click="OnAcceptStartup" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="Notice" Margin="20,4,20,8" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <!-- The window's pages (the HUD's mockup, section 5): Limits, Usage, Leaderboard and Settings. -->
        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        OpenPaneLength="172" IsSettingsVisible="True" IsTitleBarAutoPaddingEnabled="False" SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LimitsItem" Content="Limits" Tag="limits">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UsageItem" Content="Usage" Tag="usage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LeaderboardItem" Content="Leaderboard" Tag="leaderboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE728;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        <Grid>

        <!-- Limits: every reading the HUD has, with full names, and its actions; the keyboard and Narrator path to them -->
        <ScrollViewer x:Name="LimitsPage" Visibility="Collapsed">
            <StackPanel Padding="24,14,24,24" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Limits" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="LimitsSubtitle" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <HyperlinkButton x:Name="LimitsRefresh" Content="Refresh" Click="OnRefreshLimits" Padding="6,2" />
                        <ProgressRing x:Name="LimitsBusy" IsActive="False" Width="14" Height="14" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="LimitsList" Spacing="12" />
            </StackPanel>
        </ScrollViewer>

        <!-- Usage: today's tokens on this PC, from the tools' local logs -->
        <ScrollViewer x:Name="UsagePage" Visibility="Collapsed">
            <StackPanel Padding="24,14,24,24" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Usage" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="UsageSubtitle" Text="Tokens on this PC, from each tool's local logs" Style="{StaticResource Secondary}" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Today" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="UsageToday" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Text="Counting…" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="UsageList" Spacing="4" />
            </StackPanel>
        </ScrollViewer>

        <!-- 1 · Join -->
        <ScrollViewer x:Name="JoinPage" Visibility="Collapsed">
            <StackPanel Padding="24,6,24,24" Spacing="0">
                <Grid ColumnSpacing="12" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="See where you rank" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Share your daily token totals with other ClaudeBar users. Only the counts leave this PC." Style="{StaticResource Secondary}" FontSize="13" />
                    </StackPanel>
                    <StackPanel x:Name="MiniPodium" Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel x:Name="NewMemberFields">
                    <TextBlock Text="Username" Margin="0,0,0,6" />
                    <Grid>
                        <TextBox x:Name="UsernameBox" PlaceholderText="pick-a-name" MaxLength="20" Padding="12,6,36,6"
                                 TextChanged="OnJoinInputChanged" KeyDown="OnUsernameKeyDown" AutomationProperties.Name="Username" />
                        <FontIcon x:Name="UsernameOk" Glyph="&#xE930;" FontSize="16" Margin="0,0,12,0" HorizontalAlignment="Right"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="3 to 20 letters, digits, - or _. Shown on the board unless you hide it." Style="{StaticResource Tertiary}" Margin="0,6,0,18" />
                </StackPanel>

                <!-- Adding this PC to a member already on the leaderboard from another computer (ClaudeBar design §2a) -->
                <StackPanel x:Name="DevicePanel" Visibility="Collapsed" Spacing="8" Margin="0,0,0,18">
                    <TextBlock Text="Add this PC to your membership" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="On a computer that's already on the leaderboard, open ClaudeBar's settings, go to Leaderboard, then Devices, choose Add a device and type this code."
                               Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="DeviceCodeText" FontFamily="Cascadia Mono, Consolas" FontSize="28" FontWeight="SemiBold"
                               IsTextSelectionEnabled="True" CharacterSpacing="120" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="DeviceBusy" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="DeviceStatus" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DeclineDeviceButton" Content="That's not me" Visibility="Collapsed" Click="OnDeclineDevice" />
                        <Button x:Name="NewCodeButton" Content="Get a new code" Visibility="Collapsed" Click="OnAddThisPc" />
                        <Button x:Name="CancelDeviceButton" Content="Cancel" Click="OnCancelDevice" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Share tokens from" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                <StackPanel x:Name="JoinProviders" Spacing="4" />

                <Expander x:Name="PayloadExpander" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE890;" FontSize="14" />
                            <TextBlock Text="Exactly what gets uploaded" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PayloadText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="That's today. The first upload sends each of the last 30 days the same way, then once an hour." Style="{StaticResource Tertiary}" />
                    </StackPanel>
                </Expander>

                <Grid Margin="0,16,0,0">
                    <Button x:Name="JoinButton" Content="Join leaderboard" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                            HorizontalAlignment="Stretch" MinHeight="36" Click="OnJoin" />
                    <ProgressRing x:Name="JoinBusy" IsActive="False" Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,12,0" />
                </Grid>
                <TextBlock Text="Never prompts, projects, paths, costs or emails. This PC uploads every hour while you're signed in; leaving deletes it all."
                           Style="{StaticResource Tertiary}" Margin="2,10,2,0" />
                <HyperlinkButton x:Name="AddThisPcLink" Content="Already on the leaderboard from another computer? Add this PC" Margin="-10,10,0,0" Click="OnAddThisPc" />
            </StackPanel>
        </ScrollViewer>

        <!-- 2 · Board -->
        <Grid x:Name="BoardPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="24,2,14,8" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Leaderboard" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="BoardSubtitle" Style="{StaticResource Tertiary}" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="OnRefresh"
                        ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnOpenSettings"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <SelectorBar x:Name="Periods" Grid.Row="1" Margin="12,0,12,0" SelectionChanged="OnPeriodChanged">
                <SelectorBarItem Text="Today" Tag="today" />
                <SelectorBarItem Text="7 days" Tag="7d" IsSelected="True" />
                <SelectorBarItem Text="30 days" Tag="30d" />
            </SelectorBar>

            <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Pills" Orientation="Horizontal" Spacing="6" Padding="24,8,24,12" />
            </ScrollViewer>

            <Grid Grid.Row="3">
                <ScrollViewer x:Name="BoardScroll" ViewChanged="OnBoardScrolled">
                    <StackPanel Padding="24,0,24,16" Spacing="12">
                        <TextBlock x:Name="BoardNote" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <!-- Your rank, as the Mac's popover leads with it -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Rectangle RadiusX="8" RadiusY="8" Opacity="0.22" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0,0" RadiusX="0.9" RadiusY="1.4" GradientOrigin="0,0">
                                            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="0.6" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Padding="16,14,16,14" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RankText" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.Name="Your rank">
                                        <Run x:Name="RankHash" Text="#" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run x:Name="RankNumber" Text="–" FontSize="58" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="RankCaption" Style="{StaticResource Eyebrow}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="RankName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border x:Name="HiddenChip" Visibility="Collapsed" CornerRadius="9" Padding="7,1,8,1" BorderThickness="1"
                                                    VerticalAlignment="Center" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xED1A;" FontSize="11" />
                                                    <TextBlock Text="Hidden" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,2,0,0">
                                            <Run x:Name="TokensNumber" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" /><Run x:Name="TokensUnit" Text=" tokens" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <Grid x:Name="RankMix" Height="6" Margin="0,8,0,0" ColumnSpacing="2" />
                                        <StackPanel x:Name="RankLegend" Orientation="Horizontal" Spacing="12" Margin="0,6,0,0" />
                                        <StackPanel x:Name="GapLine" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="GapText" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid x:Name="Podium" ColumnSpacing="8" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.08*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <StackPanel x:Name="Standings" />

                        <StackPanel x:Name="BoardStatus" Spacing="10" Margin="0,28,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing x:Name="BoardBusy" IsActive="False" Width="28" Height="28" />
                            <TextBlock x:Name="BoardStatusText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="PinnedYou" VerticalAlignment="Bottom" Margin="24,0,24,8" CornerRadius="6" Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Grid>

            <Grid Grid.Row="4" Padding="24,8,14,8" ColumnSpacing="8" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="UploadIcon" Glyph="&#xE930;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="UploadStatus" Grid.Column="1" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <ProgressRing x:Name="UploadBusy" Grid.Column="2" IsActive="False" Width="16" Height="16" />
                <HyperlinkButton x:Name="UploadLink" Grid.Column="3" Content="Upload now" Click="OnUploadNow" Padding="8,4" />
            </Grid>
        </Grid>

        <!-- 3 · Settings -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="24,14,24,10" />
            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="24,0,24,24" Spacing="2">
                    <TextBlock Text="General" Style="{StaticResource GroupTitle}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" />
                                <TextBlock Text="Open ClaudeBar when you sign in, with the HUD. Windows also lists it in Settings, Apps, Startup." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                          Toggled="OnStartupToggled" AutomationProperties.Name="Start with Windows" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7C4;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Icon in the system tray" />
                                <TextBlock Text="Click it for your place. Closing the window keeps ClaudeBar there. Windows puts new icons under ^; drag it onto the taskbar to keep it in view."
                                           Style="{StaticResource Tertiary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TraySwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                          Toggled="OnTrayToggled" AutomationProperties.Name="Icon in the system tray" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE718;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="On the taskbar" />
                                <TextBlock Text="A dot on ClaudeBar's button shows the worst limit: amber, or red. Hover the button for your place; right-click it to show the HUD or upload. To keep it there, right-click it and choose Pin to taskbar."
                                           Style="{StaticResource Tertiary}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Settings › HUD (the HUD's mockup, section 6): six settings, no more -->
                    <TextBlock Text="HUD" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show the HUD" />
                                <TextBlock Text="A small window with your limits that stays on screen" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HudSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                          Toggled="OnHudToggled" AutomationProperties.Name="Show the HUD" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A9;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Style" />
                                <TextBlock Text="The strip is one line; click it for the card" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ComboBox x:Name="HudStyleBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="120"
                                      SelectionChanged="OnHudStyleChanged" AutomationProperties.Name="HUD style">
                                <ComboBoxItem Content="Card" Tag="card" />
                                <ComboBoxItem Content="Strip" Tag="strip" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F8;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Corner" />
                                <TextBlock Text="Or drag the HUD; it snaps to the nearest corner of that screen" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ComboBox x:Name="HudCornerBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="120"
                                      SelectionChanged="OnHudCornerChanged" AutomationProperties.Name="HUD corner">
                                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                <ComboBoxItem Content="Top right" Tag="TopRight" />
                                <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE718;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Keep it on top" />
                                <TextBlock Text="Hidden while a full-screen app, game or presentation runs" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HudOnTopSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                          Toggled="OnHudOnTopToggled" AutomationProperties.Name="Keep the HUD on top" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tools on the HUD" />
                                <TextBlock x:Name="HudToolsText" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <Button x:Name="HudToolsButton" Grid.Column="2" Content="Choose" VerticalAlignment="Center"
                                    Click="OnChooseTools" AutomationProperties.Name="Choose the tools on the HUD" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Shortcut to show or hide it" />
                                <TextBlock x:Name="HudShortcutText" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="HudShortcutClear" Content="Clear" Click="OnClearShortcut" AutomationProperties.Name="Clear the HUD's shortcut" />
                                <Button Content="Set" Click="OnSetShortcut" AutomationProperties.Name="Set the HUD's shortcut" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Leaderboard" Style="{StaticResource GroupTitle}" />
                    <Border x:Name="NotJoinedSettings" Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE728;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Not on the leaderboard" />
                                <TextBlock Text="Join to see where you rank. Only daily token counts leave this PC." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open the leaderboard" Click="OnOpenLeaderboard" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="LeaderboardSettings" Spacing="2">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Grid Width="48" Height="48">
                                <Ellipse x:Name="ProfileAvatar" />
                                <TextBlock x:Name="ProfileInitial" FontSize="20" FontWeight="SemiBold" Foreground="#1B1A19"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileDevice" Style="{StaticResource Tertiary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE890;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show me on the board" />
                                <TextBlock Text="Hidden, you still see your own place; no one else sees you." Style="{StaticResource Tertiary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="VisibleSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                          Toggled="OnVisibleToggled" AutomationProperties.Name="Show me on the board" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Sharing" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE72D;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Providers" />
                                    <TextBlock Text="Turning one off stops new uploads for it; days already sent stay until you leave." Style="{StaticResource Tertiary}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="MemberProviders" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Uploads" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE753;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Every hour while you're signed in" />
                                <TextBlock x:Name="UploadDetail" Style="{StaticResource Tertiary}" />
                            </StackPanel>
                            <Button x:Name="UploadButton" Grid.Column="2" Content="Upload now" Click="OnUploadNow" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Your data" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Export my data" />
                                <TextBlock Text="Everything the server holds about you, as JSON." Style="{StaticResource Tertiary}" />
                            </StackPanel>
                            <Button x:Name="ExportButton" Grid.Column="2" Content="Export…" Click="OnExport" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="16,10" ColumnSpacing="14" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE89B;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Leave the leaderboard" />
                                <TextBlock Text="Deletes your name and every uploaded day from the server, then this PC's key." Style="{StaticResource Tertiary}" />
                            </StackPanel>
                            <Button x:Name="LeaveButton" Grid.Column="2" Content="Leave…" Click="OnLeave" VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.Name="Leave and delete my data" />
                        </Grid>
                    </Border>

                    </StackPanel>

                    <TextBlock x:Name="VersionText" Style="{StaticResource Tertiary}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
        </NavigationView>
    </Grid>
</Window>
