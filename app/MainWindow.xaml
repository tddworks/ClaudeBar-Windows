<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeBar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClaudeBar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,20,24,8" Spacing="2">
            <TextBlock Text="ClaudeBar Leaderboard" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Caption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar x:Name="Notice" Grid.Row="1" Margin="24,0,24,8" IsOpen="False" IsClosable="True" />

        <!-- Not a member yet -->
        <ScrollViewer x:Name="JoinPanel" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Padding="24,4,24,24" Spacing="16">
                <TextBlock Text="Share your daily token totals and see where you rank. Only token counts leave this PC: no prompts, projects, paths, costs or emails."
                           TextWrapping="Wrap" />
                <TextBox x:Name="UsernameBox" Header="Username" Description="3 to 20 letters, digits, - or _" MaxLength="20"
                         TextChanged="OnJoinInputChanged" KeyDown="OnUsernameKeyDown" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Share" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Pick at least one. Tokens found in this PC's logs over the last 30 days." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="JoinProviders" Spacing="2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="JoinButton" Content="Join" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnJoin" />
                    <ProgressRing x:Name="JoinBusy" IsActive="False" Width="20" Height="20" />
                </StackPanel>
                <TextBlock Text="After joining, this PC uploads every hour while you're signed in."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- A member: the board, and the membership on its own page -->
        <NavigationView x:Name="MemberNav" Grid.Row="2" Visibility="Collapsed" PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnMemberNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="BoardItem" Content="Board" Tag="board" />
                <NavigationViewItem Content="Membership" Tag="membership" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="BoardView" Padding="24,12,24,16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="Periods" SelectionChanged="OnPeriodChanged">
                            <SelectorBarItem Text="Today" Tag="today" />
                            <SelectorBarItem Text="7 days" Tag="7d" IsSelected="True" />
                            <SelectorBarItem Text="30 days" Tag="30d" />
                        </SelectorBar>
                        <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefresh" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                    </Grid>

                    <!-- Your rank, as the Mac's popover shows it -->
                    <Border Grid.Row="1" Padding="16,12" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RankText" Text="–" Style="{StaticResource TitleLargeTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="RankCaption" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TokensText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="GapText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BoardNote" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <Grid Grid.Row="3">
                        <ScrollViewer>
                            <StackPanel x:Name="Standings" Spacing="2" />
                        </ScrollViewer>
                        <StackPanel x:Name="BoardStatus" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing x:Name="BoardBusy" IsActive="False" Width="28" Height="28" />
                            <TextBlock x:Name="BoardStatusText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="MembershipView" Visibility="Collapsed">
                    <StackPanel Padding="24,12,24,24" Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="MemberName" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UploadText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch x:Name="VisibleSwitch" Header="Show me on the board" OnContent="Shown" OffContent="Hidden"
                                      Toggled="OnVisibleToggled" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Share" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Turning a provider off stops new uploads for it; days already uploaded stay until you leave."
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="MemberProviders" Spacing="0" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Upload" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="UploadButton" Content="Upload now" Click="OnUploadNow" />
                                <ProgressRing x:Name="UploadBusy" IsActive="False" Width="20" Height="20" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Leave the leaderboard" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Deletes your username and every uploaded day from the server, then this PC's key."
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="LeaveButton" Content="Leave and delete my data…" Click="OnLeave" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
