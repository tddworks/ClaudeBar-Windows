<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ClaudeBar</RootNamespace>
    <AssemblyName>ClaudeBar</AssemblyName>
    <Version>0.1.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ClaudeBar.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged until the packaging is chosen (MSIX or a signed exe). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: one instance, a second launch hands over its arguments. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI and what it pulls in, not the Microsoft.WindowsAppSDK metapackage (46 MB of AI/ML parts); as the UI spike chose. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClaudeBarNative.dll, claudebar-upload.exe, the Swift runtime and ClaudeBar's resource bundles, staged by build.ps1. -->
    <Content Include="..\native-out\$(RuntimeIdentifier)\**\*" LinkBase="." CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sample readings the HUD check shows (HudCheck.cs). -->
    <EmbeddedResource Include="..\tests\hud-check.json" LogicalName="hud-check.json" />
    <EmbeddedResource Include="..\tests\hud-check-fine.json" LogicalName="hud-check-fine.json" />
  </ItemGroup>

  <!-- AppNotificationManager.Register() needs Microsoft.WindowsAppRuntime.Insights.Resource.dll,
       which only the Runtime package's MSIX carries: a self-contained publish leaves it out, and
       Register throws 0x8007007E, so no notification's button comes back to the app
       (microsoft/WindowsAppSDK#6774, open on 2.5.1). Taken from that MSIX, the same version. -->
  <Target Name="AddNotificationResources" BeforeTargets="AssignTargetPaths" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <RuntimeMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-$(RuntimeIdentifier.Replace('win-', ''))\Microsoft.WindowsAppRuntime.2.msix</RuntimeMsix>
      <RuntimeResources>$(IntermediateOutputPath)runtime-resources\</RuntimeResources>
    </PropertyGroup>
    <Unzip SourceFiles="$(RuntimeMsix)" DestinationFolder="$(RuntimeResources)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="$(RuntimeResources)Microsoft.WindowsAppRuntime.Insights.Resource.dll" Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
